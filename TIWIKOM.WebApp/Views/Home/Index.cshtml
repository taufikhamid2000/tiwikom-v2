@model List<Tip>
@using TIWIKOM.WebApp.Helpers
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">Things I Wish I Knew On My first day...</h1>
            
            <!-- Search and Filter Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <form asp-controller="Home" asp-action="Index" method="get" class="row g-3">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control" placeholder="Search tips, content, or author..." value="@ViewBag.SearchTerm">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="categoryId" class="form-select">
                                <option value="">All Categories</option>
                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id" selected="@(ViewBag.SelectedCategoryId == category.Id)">
                                        @category.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="sortBy" class="form-select">
                                <option value="date" selected="@(ViewBag.SortBy == "date" || string.IsNullOrEmpty(ViewBag.SortBy))">Newest First</option>
                                <option value="popular" selected="@(ViewBag.SortBy == "popular")">Most Liked</option>
                                <option value="views" selected="@(ViewBag.SortBy == "views")">Most Viewed</option>
                                <option value="comments" selected="@(ViewBag.SortBy == "comments")">Most Discussed</option>
                                <option value="title" selected="@(ViewBag.SortBy == "title")">Title A-Z</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-funnel"></i>
                            </button>
                        </div>
                    </form>
                    
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.SelectedCategoryId != null)
                    {
                        <div class="mt-3">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Clear Filters
                            </a>
                            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                            {
                                <span class="badge bg-info ms-2">Search: "@ViewBag.SearchTerm"</span>
                            }
                            @if (ViewBag.SelectedCategoryId != null)
                            {
                                var selectedCategory = ((List<Category>)ViewBag.Categories).FirstOrDefault(c => c.Id == ViewBag.SelectedCategoryId);
                                <span class="badge bg-primary ms-2">Category: @selectedCategory?.Name</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Category Filter Pills -->
            <div class="mb-4">
                <a asp-controller="Home" asp-action="Index" 
                   class="btn btn-sm @(ViewBag.SelectedCategoryId == null && string.IsNullOrEmpty(ViewBag.SearchTerm) ? "btn-primary" : "btn-outline-primary") me-2">
                    All
                </a>
                @foreach (var category in ViewBag.Categories)
                {
                    <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@category.Id" 
                       class="btn btn-sm @(ViewBag.SelectedCategoryId == category.Id ? "btn-primary" : "btn-outline-primary") me-2">
                        @category.Name
                    </a>
                }
            </div>

            <!-- Tips List -->
            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var tip in Model)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">@tip.Title</h5>
                                    <p class="card-text">
                                        <span class="badge bg-primary">@tip.Category?.Name</span>
                                        <span class="badge bg-secondary">TIWIKOM @tip.Abbreviation</span>
                                    </p>
                                    <p class="card-text">
                                        @TextHelper.GetPreview(tip.Content, 150)
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            By @tip.Author?.FirstName @tip.Author?.LastName<br />
                                            <i class="bi bi-eye"></i> @tip.ViewCount
                                            <i class="bi bi-heart ms-2"></i> @tip.Likes.Count
                                            <i class="bi bi-chat-dots ms-2"></i> @tip.Comments.Count
                                        </small>
                                        <a asp-controller="Tips" asp-action="Detail" asp-route-id="@tip.Id" class="btn btn-sm btn-primary">Read More</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Home" asp-action="Index" 
                                       asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
                                       asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                       asp-route-search="@ViewBag.SearchTerm"
                                       asp-route-sortBy="@ViewBag.SortBy">Previous</a>
                                </li>
                            }
                            
                            @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Home" asp-action="Index" 
                                       asp-route-pageNumber="@i"
                                       asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                       asp-route-search="@ViewBag.SearchTerm"
                                       asp-route-sortBy="@ViewBag.SortBy">@i</a>
                                </li>
                            }
                            
                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Home" asp-action="Index" 
                                       asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
                                       asp-route-categoryId="@ViewBag.SelectedCategoryId"
                                       asp-route-search="@ViewBag.SearchTerm"
                                       asp-route-sortBy="@ViewBag.SortBy">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <h4>No tips found</h4>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.SelectedCategoryId != null)
                    {
                        <p>Try adjusting your search or filters. <a asp-controller="Home" asp-action="Index">View all tips</a></p>
                    }
                    else
                    {
                        <p>Be the first to share your knowledge!</p>
                    }
                </div>
            }
        </div>
    </div>
</div>
