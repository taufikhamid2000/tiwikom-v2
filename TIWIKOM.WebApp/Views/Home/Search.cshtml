@model List<Tip>
@{
    ViewData["Title"] = $"Search Results for '{ViewBag.SearchQuery}'";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2>Search Results</h2>
            <p class="text-muted">Found <strong>@ViewBag.TotalResults</strong> results for "<strong>@ViewBag.SearchQuery</strong>"</p>
            <hr />

            @if (Model != null && Model.Any())
            {
                <div class="list-group">
                    @foreach (var tip in Model)
                    {
                        <a asp-controller="Tips" asp-action="Detail" asp-route-id="@tip.Id" class="list-group-item list-group-item-action mb-3">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@tip.Title</h5>
                                <small class="text-muted">@tip.CreatedDate.ToString("MMM dd, yyyy")</small>
                            </div>
                            <p class="mb-1">
                                <span class="badge bg-primary">@tip.Category?.Name</span>
                                <span class="badge bg-secondary">@tip.Abbreviation</span>
                            </p>
                            <p class="mb-1">
                                @if (tip.Content.Length > 200)
                                {
                                    @tip.Content.Substring(0, 200)<text>...</text>
                                }
                                else
                                {
                                    @tip.Content
                                }
                            </p>
                            <small class="text-muted">
                                By @tip.Author?.FirstName @tip.Author?.LastName • 
                                <i class="bi bi-eye"></i> @tip.ViewCount views • 
                                <i class="bi bi-heart"></i> @tip.Likes.Count likes • 
                                <i class="bi bi-chat-dots"></i> @tip.Comments.Count comments
                            </small>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <h4>No results found</h4>
                    <p>Try different keywords or <a asp-controller="Home" asp-action="Index">browse all tips</a>.</p>
                </div>
            }

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">← Back to All Tips</a>
            </div>
        </div>
    </div>
</div>
