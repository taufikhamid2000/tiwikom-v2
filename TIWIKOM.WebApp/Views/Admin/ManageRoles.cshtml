@model ManageRolesViewModel
@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2>Manage Roles</h2>
            <hr />

            <div class="alert alert-info">
                <strong>User:</strong> @Model.UserEmail
            </div>

            <form asp-controller="Admin" asp-action="ManageRoles" method="post">
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="UserEmail" />

                <div class="mb-3">
                    <label class="form-label"><strong>Select Roles:</strong></label>
                    @for (int i = 0; i < Model.UserRoles.Count; i++)
                    {
                        <div class="form-check">
                            <input type="hidden" asp-for="UserRoles[i].RoleName" />
                            <input class="form-check-input" type="checkbox" asp-for="UserRoles[i].IsSelected" id="role_@i" />
                            <label class="form-check-label" for="role_@i">
                                @Model.UserRoles[i].RoleName
                            </label>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
