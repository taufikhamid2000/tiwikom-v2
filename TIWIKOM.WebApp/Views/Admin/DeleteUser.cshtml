@model UserViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h2>Delete User</h2>
            <hr />

            <div class="alert alert-danger">
                <h4>Are you sure you want to delete this user?</h4>
                <p>This action cannot be undone. All tips created by this user will remain but will be orphaned.</p>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@Model.Email</h5>
                    <p class="card-text">
                        <strong>Name:</strong> @Model.FirstName @Model.LastName<br />
                        <strong>Roles:</strong>
                        @if (Model.Roles.Any())
                        {
                            foreach (var role in Model.Roles)
                            {
                                <span class="badge bg-primary">@role</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">No roles</span>
                        }
                    </p>
                </div>
            </div>

            <form asp-controller="Admin" asp-action="DeleteUser" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mt-3">
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
