@model List<Tip>
@{
    ViewData["Title"] = "My Tips";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Tips</h2>
        <a asp-controller="Tips" asp-action="Create" class="btn btn-primary">Create New Tip</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var tip in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title">@tip.Title</h5>
                                @if (!tip.IsPublished)
                                {
                                    <span class="badge bg-warning text-dark">Draft</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                            </div>
                            
                            <p class="card-text">
                                <span class="badge bg-primary">@tip.Category?.Name</span>
                                <span class="badge bg-secondary">TIWIKOM @tip.Abbreviation</span>
                            </p>
                            
                            <p class="card-text">
                                @if (tip.Content.Length > 150)
                                {
                                    @tip.Content.Substring(0, 150)<text>...</text>
                                }
                                else
                                {
                                    @tip.Content
                                }
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    Created: @tip.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")<br />
                                    Views: @tip.ViewCount
                                </small>
                                <div>
                                    <a asp-controller="Tips" asp-action="Detail" asp-route-id="@tip.Id" class="btn btn-sm btn-info">View</a>
                                    <a asp-controller="Tips" asp-action="Edit" asp-route-id="@tip.Id" class="btn btn-sm btn-warning">Edit</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No tips yet!</h4>
            <p>You haven't created any tips yet. <a asp-controller="Tips" asp-action="Create">Create your first tip</a> to get started.</p>
        </div>
    }
</div>
